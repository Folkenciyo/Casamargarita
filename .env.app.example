# Copiar a .env.app — secretos de la aplicación.
# Compose los carga con `format: raw`, así que el "$" del hash argon2 llega
# intacto al contenedor. En Dokploy estas mismas variables se definen en su UI.

# Mínimo 32 caracteres aleatorios.
# Generar: docker compose exec web node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=

# Acceso de la artista al panel.
ADMIN_EMAIL=
# Generar: docker compose exec web pnpm hash-password
ADMIN_PASSWORD_HASH=

# URL pública: metadata, og:image y sitemap.
PUBLIC_URL=https://ejemplo.com

# Identidad del sitio: título de la pestaña, og:image y tarjetas al compartir.
# Sin esto sale "Casa Margarita". El nombre que aparece en la cabecera de la
# web sigue saliendo de la ficha de artista.
PUBLIC_SITE_NAME=Casa Margarita
PUBLIC_SITE_DESCRIPTION=

# Aviso por email a la artista cuando llega una consulta. Opcional: sin
# SMTP_HOST/SMTP_USER/SMTP_PASS el envío se salta solo, sin error.
# Cuenta de Gmail: host smtp.gmail.com, puerto 465, y una "contraseña de
# aplicación" (no la contraseña normal) generada en
# myaccount.google.com/apppasswords.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opcional: si se omite, se usa SMTP_USER.
SMTP_FROM=

# Aviso de obra nueva. NACE APAGADO a propósito: encenderlo obliga a tener
# publicada una política de privacidad y a decir quién es el responsable del
# tratamiento de los datos. Con esto en "true" aparecen /avisos y su
# formulario; sin ello, esas rutas devuelven 404.
NEWSLETTER_ENABLED=false
