# Acceso al panel de despliegue. Copiar a `.env.dokploy`, que está en
# .gitignore y no se sube nunca.
#
# La clave se saca del panel de Dokploy: perfil → API/CLI → generar. Da control
# total sobre el servidor, incluidos los demás proyectos alojados en él, así
# que se trata como una contraseña de administrador.
#
# El panel escucha en HTTP plano sobre una IP, sin certificado: la clave viaja
# sin cifrar. Mientras siga así, no la uses desde una red que no controles.
DOKPLOY_URL=http://IP-DEL-SERVIDOR:3000
DOKPLOY_API_KEY=
