{
  "name": "casamargarita",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "hash-password": "node --experimental-strip-types scripts/hash-password.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "seed:demo": "node --experimental-strip-types scripts/seed-demo-art.ts",
    "purge-trash": "node --experimental-strip-types scripts/purge-trash.ts",
    "db:studio": "prisma studio --hostname 0.0.0.0"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.16.1",
    "file-type": "^21.0.0",
    "jose": "^6.1.0",
    "next": "^15.5.3",
    "nodemailer": "^9.0.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "^0.34.3",
    "slugify": "^1.6.6",
    "three": "^0.180.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prisma": "^6.16.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "pnpm": {
    "// onlyBuiltDependencies": "Sin esta lista pnpm ignora los postinstall en entornos sin TTY (Docker) y deja binarios a medias.",
    "onlyBuiltDependencies": [
      "@node-rs/argon2",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
